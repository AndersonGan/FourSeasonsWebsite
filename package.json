{
  "name": "four-seasons-restaurant",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Four Seasons Restaurant, 122 SE K Street, Grants Pass, Oregon.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:menu": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/validate-content.mts",
    "check:launch": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/validate-content.mts --launch",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run validate:menu && npm run typecheck && npm run lint && npm run build && npm test",
    "qr:stickers": "node scripts/make-qr-stickers.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
